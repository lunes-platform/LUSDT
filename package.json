{
  "name": "lusdt-bridge-platform",
  "version": "1.0.0",
  "description": "LUSDT Cross-chain Bridge Platform - Solana Lunes Stablecoin Bridge",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter lusdt-app dev\" \"pnpm --filter lusdt-bridge-service dev\"",
    "dev:app": "pnpm --filter lusdt-app dev",
    "dev:bridge": "pnpm --filter lusdt-bridge-service dev",
    "build": "pnpm -r build",
    "build:app": "pnpm --filter lusdt-app build",
    "build:bridge": "pnpm --filter lusdt-bridge-service build",
    "test": "pnpm -r test",
    "test:app": "pnpm --filter lusdt-app test",
    "test:bridge": "pnpm --filter lusdt-bridge-service test",
    "lint": "pnpm -r lint",
    "clean": "rm -rf node_modules lusdt-app/node_modules bridge-service/node_modules lusdt-app/dist bridge-service/dist",
    "install:all": "pnpm install"
  },
  "workspaces": [
    "lusdt-app",
    "bridge-service"
  ],
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bigint-buffer",
      "bufferutil",
      "esbuild",
      "protobufjs",
      "utf-8-validate"
    ],
    "overrides": {
      "fast-xml-parser": ">=5.7.0",
      "rollup": ">=4.59.0",
      "esbuild": ">=0.25.0",
      "h3": ">=1.15.9",
      "axios": ">=1.15.0",
      "qs": ">=6.14.2",
      "minimatch": ">=10.0.1",
      "diff": ">=4.0.4",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "bn.js": ">=5.2.3",
      "ajv": ">=6.14.0",
      "handlebars": ">=4.7.9",
      "protobufjs": ">=7.5.5",
      "flatted": ">=3.4.2",
      "defu": ">=6.1.5",
      "path-to-regexp": ">=0.1.13",
      "picomatch": ">=4.0.4",
      "socket.io-parser": ">=4.2.6",
      "undici": ">=7.24.0 <8.0.0",
      "postcss": ">=8.5.10",
      "brace-expansion": ">=5.0.5",
      "follow-redirects": ">=1.16.0",
      "yaml": ">=2.8.3",
      "uuid": ">=9.0.1 <10.0.0"
    }
  },
  "keywords": [
    "lusdt",
    "stablecoin",
    "cross-chain",
    "bridge",
    "solana",
    "lunes",
    "blockchain",
    "defi"
  ],
  "author": "LUSDT Team",
  "license": "MIT"
}