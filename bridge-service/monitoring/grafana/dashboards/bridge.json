{
  "id": null,
  "title": "LUSDT Bridge Dashboard",
  "tags": ["lusdt", "bridge"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Bridge Service - UP",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "up{job=\"bridge-service\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Transactions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "bridge_transactions_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Transaction Rate (5m)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "rate(bridge_transactions_total[5m])",
          "legendFormat": "tx/s",
          "refId": "A"
        }
      ]
    }
  ]
}
