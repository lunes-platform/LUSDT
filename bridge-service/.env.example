# ============================================================
# LUSDT Bridge Service — Environment Variables
# Copy to .env and fill in all REQUIRED values before starting.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000                                          # OPTIONAL — default 3000 (must match Dockerfile EXPOSE)
NODE_ENV=production                                # REQUIRED — production | staging | development

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.lunes.io               # REQUIRED in production — comma-separated

# ── Bridge Authentication ────────────────────────────────────
BRIDGE_API_KEY=                                    # REQUIRED — shared secret for client→bridge calls
BRIDGE_API_SECRET=                                 # REQUIRED — used for HMAC-SHA256 request signing

# ── Ops / Admin Endpoints (Basic Auth) ───────────────────────
OPS_BASIC_AUTH_USER=                               # REQUIRED in production — protects /admin /ops routes
OPS_BASIC_AUTH_PASS=                               # REQUIRED in production — use a strong random password

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/bridge_db  # REQUIRED
REDIS_URL=redis://localhost:6379                   # OPTIONAL — used for rate-limit/cache (falls back to in-memory)

# ── Solana ───────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com # REQUIRED in production (devnet: https://api.devnet.solana.com)
SOLANA_WALLET_PRIVATE_KEY=                         # REQUIRED in production — base58 hot-wallet private key (or leave blank when using KMS)
USDT_TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  # REQUIRED — mainnet USDT SPL mint address
SOLANA_MULTISIG_VAULT=                             # REQUIRED in production — Squads v4 vault address for fee custody

# Fee distribution wallets (must receive 80/15/5 split)
DEV_SOLANA_WALLET=                                 # REQUIRED in production
INSURANCE_SOLANA_WALLET=                           # REQUIRED in production
STAKING_REWARDS_SOLANA_WALLET=                     # REQUIRED in production

# ── Solana Guardian Keys (multisig co-signers) ───────────────
# Public keys only — private keys must live in bridge-service/solana-keys/ (never committed to git)
# Run: bash scripts/setup-guardian-keys.sh to generate a new key set
SOLANA_GUARDIAN_1_PUBLIC_KEY=                      # REQUIRED if REQUIRE_MULTISIG_VAULT=true
SOLANA_GUARDIAN_2_PUBLIC_KEY=                      # REQUIRED if REQUIRE_MULTISIG_VAULT=true
SOLANA_GUARDIAN_3_PUBLIC_KEY=                      # REQUIRED if REQUIRE_MULTISIG_VAULT=true
SOLANA_GUARDIAN_4_PUBLIC_KEY=                      # OPTIONAL — for 4-of-5 threshold
SOLANA_GUARDIAN_5_PUBLIC_KEY=                      # OPTIONAL — for 5-of-5 threshold

# ── Lunes (Polkadot/ink!) ────────────────────────────────────
LUNES_RPC_URL=wss://node.lunes.io                  # REQUIRED in production (dev: ws://localhost:9944)
LUNES_WALLET_SEED=                                 # REQUIRED in production — 12/24-word mnemonic seed phrase
LUSDT_CONTRACT_ADDRESS=                            # REQUIRED in production — deployed ink! contract address
TAX_MANAGER_CONTRACT_ADDRESS=                      # REQUIRED in production — deployed TaxManager contract address
LUSDT_CONTRACT_ABI_PATH=./abi/lusdt.json           # REQUIRED — path to ink! ABI file
TAX_MANAGER_CONTRACT_ABI_PATH=./abi/tax_manager.json  # REQUIRED — path to ink! ABI file

# ── HSM / Key Management ─────────────────────────────────────
HSM_TYPE=development                               # REQUIRED — development | aws-kms | hashicorp-vault
# AWS KMS (required when HSM_TYPE=aws-kms)
AWS_KMS_KEY_ID=                                    # REQUIRED for aws-kms — KMS key ID or ARN
AWS_REGION=us-east-1                               # REQUIRED for aws-kms
SOLANA_ENCRYPTED_KEY=                              # REQUIRED for aws-kms — KMS envelope-encrypted ed25519 key (base64)
# HashiCorp Vault (required when HSM_TYPE=hashicorp-vault)
VAULT_URL=                                         # REQUIRED for hashicorp-vault
VAULT_TOKEN=                                       # REQUIRED for hashicorp-vault
VAULT_KEY_PATH=                                    # REQUIRED for hashicorp-vault
VAULT_KEY_NAME=solana-bridge                       # OPTIONAL — default: solana-bridge
BACKUP_HSM_TYPE=                                   # OPTIONAL — fallback HSM type

# ── Multisig Policy ──────────────────────────────────────────
REQUIRE_MULTISIG_VAULT=true                        # REQUIRED in production — must be true
BOT_ORIGIN_KEY_ID=                                 # REQUIRED if REQUIRE_MULTISIG_VAULT=true — origin bot KMS key ID
BOT_RISK_KEY_ID=                                   # REQUIRED if REQUIRE_MULTISIG_VAULT=true — risk bot KMS key ID
BOT_BACKUP_KEY_ID=                                 # OPTIONAL — backup bot KMS key ID
MULTISIG_REQUIRED_APPROVALS=2                      # OPTIONAL — default 2 (minimum approvals to execute)
MULTISIG_TOTAL_BOTS=3                              # OPTIONAL — default 3
MULTISIG_HIGH_VALUE_THRESHOLD=5000                 # OPTIONAL — USDT amount triggering extra approval
MULTISIG_TIMELOCK_MS=600000                        # OPTIONAL — ms delay before high-value execution (10 min)
MULTISIG_PROPOSAL_TTL_MS=300000                    # OPTIONAL — ms until proposal expires (5 min)

# ── Spending Limits ──────────────────────────────────────────
MAX_TRANSACTION_VALUE=100000                       # OPTIONAL — hard cap per transaction in USDT
HOT_WALLET_SINGLE_TX_LIMIT=10000                   # OPTIONAL — hot wallet per-tx limit
HOT_WALLET_DAILY_LIMIT=50000                       # OPTIONAL — hot wallet rolling-24h limit
TREASURY_MIN_BALANCE=50000                         # OPTIONAL — alert threshold for low treasury

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=50                             # OPTIONAL — default 50 in production, 100 in staging

# ── Bridge Processing ─────────────────────────────────────────
REQUIRED_CONFIRMATIONS=finalized                   # OPTIONAL — finalized | inBlock (always use finalized in prod)
MAX_RETRIES=3                                      # OPTIONAL
RETRY_DELAY=5000                                   # OPTIONAL — ms between retries
PROCESSING_TIMEOUT=30000                           # OPTIONAL — ms before a bridge step times out

# ── Monitoring & Alerts ───────────────────────────────────────
ALERT_EMAIL=                                       # REQUIRED in production — email for critical alerts
DISCORD_WEBHOOK_URL=                               # OPTIONAL — Discord webhook for ops alerts
HEALTH_CHECK_INTERVAL=30000                        # OPTIONAL — ms between internal health checks
PARITY_CHECK_INTERVAL=60000                        # OPTIONAL — ms between LUSDT/USDT parity checks
PARITY_DEVIATION_THRESHOLD=0.01                    # OPTIONAL — max allowed parity deviation (1%)

# ── Monitoring Stack (docker-compose) ────────────────────────
GRAFANA_ADMIN_PASSWORD=                            # REQUIRED if running Grafana — set a strong password
